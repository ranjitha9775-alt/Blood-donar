PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=blood_donar_portal
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
HEALTH_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-locally
DONATION_ELIGIBILITY_MONTHS=3
DONOR_RESPONSE_WINDOW_MINUTES=120
# Set both values privately before starting the server to enable the admin account.
ADMIN_USERNAME=choose_a_private_admin_username
ADMIN_PASSWORD=use_a_unique_password_of_at_least_12_characters
